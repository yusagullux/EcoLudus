# EcoLudus environment variables.
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must NEVER be committed.

# ── Database (Postgres) ────────────────────────────────────────────────────
# The app talks to Postgres directly via `pg`. Provide ONE of the connection
# strings below. Without any of them, dev falls back to a JSON file store at
# data/local-db.json (dev only — production throws DatabaseSetupError).
DATABASE_URL=postgresql://user:password@host:5432/postgres
# Vercel-injected alternatives (used if DATABASE_URL is absent):
# POSTGRES_URL=postgresql://user:password@host:5432/postgres
# POSTGRES_URL_NON_POOLING=postgresql://user:password@host:5432/postgres
# POSTGRES_PRISMA_URL=postgresql://user:password@host:5432/postgres
# Force TLS. Omit for local Postgres; set to "true" for Supabase/managed.
POSTGRES_SSL=true
# Force the data store mode regardless of auto-detection. "postgres" or "file".
LOCAL_DB_MODE=postgres

# ── Auth / sessions ─────────────────────────────────────────────────────────
# Signs the httpOnly ecoquest_session JWT cookie (jose, HS256, 14-day TTL).
# REQUIRED in production. Use a long random string (e.g. `openssl rand -hex 32`).
SESSION_SECRET=replace-with-a-long-random-secret

# ── Cron jobs ──────────────────────────────────────────────────────────────
# Bearer token authenticating /api/cron/* jobs. Vercel Cron sends this in the
# Authorization header. Use a long random string.
CRON_SECRET=replace-with-a-long-random-secret

# ── Gemini (AI photo / mission verification) ──────────────────────────────
# Optional. When absent, verification falls back to local heuristics.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Alternative AI verification provider (optional) ────────────────────────
# Used as a fallback before heuristic verification. Leave unset to use Gemini.
# AI_VERIFICATION_ENDPOINT=https://example.com/v1/verify
# AI_VERIFICATION_API_KEY=

# ── Climatiq (carbon estimates) ───────────────────────────────────────────
# Optional. When absent, carbon values fall back to the quests.json catalog.
CLIMATIQ_API_KEY=

# ── Ecologi (real tree planting) ───────────────────────────────────────────
# Optional. When absent, milestones are marked claimed but no tree is planted.
ECOLOGI_API_KEY=

# ── SendGrid (weekly impact emails) ────────────────────────────────────────
# Optional. When absent, the weekly-reports cron skips sending and returns 200.
SENDGRID_API_KEY=
SENDGRID_FROM=hello@ecoludus.com

# ── Supabase Storage (avatar uploads) ──────────────────────────────────────
# Optional. When absent, /api/users/avatar returns 503 (avatar upload disabled).
# SUPABASE_URL is derived from DATABASE_URL if omitted.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Sentry (error monitoring) ─────────────────────────────────────────────
# Optional. When absent, instrumentation.ts skips Sentry init and logError only
# writes the structured log line. Leave empty in dev / until you have a DSN.
SENTRY_DSN=
# Transaction trace sample rate (0–1). Defaults to 1.0 in dev, 0.1 in prod.
# SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Logging ────────────────────────────────────────────────────────────────
# Minimum log level emitted by lib/logger.ts: debug | info | warn | error.
LOG_LEVEL=info